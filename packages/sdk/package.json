{
  "name": "@vsc.eco/nft-sdk",
  "version": "0.0.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Magi (VSC) NFT + token SDK — Hasura-indexed reads, view-state queries, and a broadcast orchestrator",
  "keywords": ["hive", "vsc", "magi", "nft", "erc1155", "indexer", "hasura"],
  "homepage": "https://github.com/vsc-eco/nft-sdk/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vsc-eco/nft-sdk.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vsc.eco/nft-core": "0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
